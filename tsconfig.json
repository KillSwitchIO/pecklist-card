{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": false,
		"useDefineForClassFields": false,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "tests"]
}
